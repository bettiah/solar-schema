# Segment to element mapping
# {segment_id: [(element_tag, is_composite, mandatory), ...]}
SEGMENT_ELEMENTS: dict[str, list[tuple[str, bool, bool]]] = {
{% for seg in segments %}
    {{ seg.tag|repr }}: [
{% for elem in seg.elements %}
        ({{ elem.tag|repr }}, {{ elem.is_composite }}, {{ elem.mandatory }}),
{% endfor %}
    ],
{% endfor %}
}


# Composite to component mapping
# {composite_id: [(element_tag, mandatory), ...]}
COMPOSITE_COMPONENTS: dict[str, list[tuple[str, bool]]] = {
{% for comp in composites %}
    {{ comp.tag|repr }}: [
{% for c in comp.components %}
        ({{ c.element_tag|repr }}, {{ c.mandatory }}),
{% endfor %}
    ],
{% endfor %}
}


{% if include_codes %}
